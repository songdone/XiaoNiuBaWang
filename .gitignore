# Development and delivery artifacts stay local.
/.DS_Store
/.local-data/
/build
/dist
/开发存档/
/最新安装包/
/上架资料/
/.qa-*
/.delivery-*

# Approved private appreciation originals are packaged locally, not published.
/assets/support/
/support-assets/
/donation/
**/support-disabled.flag

# Generated frontend, dependencies and local caches.
/web/dist/
**/node_modules/
**/.vite/
**/.taste-skill/
**/test-results/
/internal/store/.backend-verify/
**/__pycache__/
**/*.pyc
**/.DS_Store
/artifacts/
/test-results/
/playwright-report/
*.fpk
*.log

# Upstream diagnostic dotfiles excluded from clean history.
/emulator/diagnostics/keytest/upstream/.gitignore
/emulator/diagnostics/keytest/upstream/.gitmodules

# Credentials and local environment files never belong in the repository.
.env
.env.*
!.env.example
*.key
*.p12
*.pfx
